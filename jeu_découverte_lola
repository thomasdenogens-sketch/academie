<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Découverte du Monde CE1 - Lola</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;900&display=swap');
        
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
        
        body { 
            font-family: 'Nunito', sans-serif; 
            background: linear-gradient(135deg, #a8e063 0%, #56ab2f 100%); 
            color: #2c3e50; display: flex; flex-direction: column; align-items: center; 
            min-height: 100vh; padding: 20px; 
        }
        
        #app-container { 
            background: white; padding: 30px; border-radius: 20px; 
            box-shadow: 0 15px 35px rgba(0,0,0,0.2); max-width: 700px; width: 100%; text-align: center; position: relative;
        }
        
        h1 { color: #27ae60; font-weight: 900; font-size: 2.2rem; margin-bottom: 5px; }
        .subtitle { color: #2c3e50; font-weight: bold; font-size: 1.1rem; margin-bottom: 25px; }
        
        .xp-badge { position: absolute; top: 20px; right: 25px; font-weight: 900; background: #fff3cd; color: #f39c12; padding: 8px 15px; border-radius: 20px; border: 2px solid #ffeeba; font-size: 1.1rem;}

        /* Menu des thèmes */
        .grid-menu { display: grid; grid-template-columns: 1fr; gap: 15px; margin-bottom: 25px; }
        .btn-menu-theme {
            background: #f8f9fa; border: 3px solid #e2e8f0; padding: 15px 20px; border-radius: 15px;
            font-size: 1.2rem; font-weight: bold; color: #2c3e50; cursor: pointer; transition: 0.2s;
            display: flex; align-items: center; justify-content: flex-start; gap: 15px; text-align: left;
        }
        .btn-menu-theme:hover { transform: translateX(5px); background: #f0fdf4;}
        .theme-espace { border-color: #3498db; }
        .theme-temps { border-color: #e67e22; }
        .theme-vivant { border-color: #27ae60; }
        .theme-icon { font-size: 2.5rem; }

        /* HUD Jeu */
        #hud { display: flex; justify-content: space-between; background: #f8f9fa; padding: 12px 20px; border-radius: 12px; margin-bottom: 20px; font-weight: bold; font-size: 1.1rem; border: 2px solid #ecf0f1;}
        
        #question-box { background: #f1f8ff; padding: 25px; border-radius: 15px; border: 3px dashed #3498db; margin-bottom: 25px; }
        #question-texte { font-size: 1.5rem; font-weight: 900; color: #2c3e50; line-height: 1.4; }
        
        .zone-boutons { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;}
        .btn-rep { background: white; border: 3px solid #bdc3c7; padding: 15px; border-radius: 12px; font-size: 1.2rem; font-weight: bold; color: #34495e; cursor: pointer; transition: 0.1s; box-shadow: 0 4px 0 #bdc3c7; display: flex; align-items: center; justify-content: center; min-height: 80px;}
        .btn-rep:active { transform: translateY(4px); box-shadow: none; }
        .btn-rep.correct { background: #2ecc71; color: white; border-color: #27ae60; box-shadow: 0 4px 0 #2196f3; }
        .btn-rep.erreur { background: #e74c3c; color: white; border-color: #c0392b; box-shadow: 0 4px 0 #c0392b; }

        /* Boutons Généraux */
        .btn-nav { background: #95a5a6; color: white; padding: 12px 25px; border: none; border-radius: 12px; font-weight: bold; cursor: pointer; font-size: 1.1rem; text-decoration: none; display: inline-block; transition: 0.2s; }
        .btn-nav:hover { background: #7f8c8d; }
        
        .ecran { display: none; }
        .ecran.actif { display: block; animation: fadeIn 0.4s; }
        @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
        
        #feedback { font-size: 1.5rem; font-weight: 900; height: 40px; margin: 15px 0; }
    </style>
</head>
<body>

    <div id="app-container">
        <div class="xp-badge" id="ui-xp">XP: ... ⭐</div>

        <!-- ECRAN D'ACCUEIL -->
        <div id="ecran-accueil" class="ecran actif">
            <h1>Découverte du Monde 🌍</h1>
            <p class="subtitle">Espace, Temps et Nature (Niveau CE1)</p>
            
            <div class="grid-menu">
                <button class="btn-menu-theme theme-espace" onclick="lancerNiveau('espace')">
                    <span class="theme-icon">🗺️</span>
                    <div>
                        <div style="color:#3498db;">L'Espace et la Géographie</div>
                        <div style="font-size:0.9rem; color:#7f8c8d;">Continents, paysages, océans...</div>
                    </div>
                </button>
                <button class="btn-menu-theme theme-temps" onclick="lancerNiveau('temps')">
                    <span class="theme-icon">⏳</span>
                    <div>
                        <div style="color:#e67e22;">Le Temps qui passe</div>
                        <div style="font-size:0.9rem; color:#7f8c8d;">Jours, mois, saisons, l'heure...</div>
                    </div>
                </button>
                <button class="btn-menu-theme theme-vivant" onclick="lancerNiveau('vivant')">
                    <span class="theme-icon">🌱</span>
                    <div>
                        <div style="color:#27ae60;">Le Monde Vivant</div>
                        <div style="font-size:0.9rem; color:#7f8c8d;">Animaux, plantes, eau...</div>
                    </div>
                </button>
            </div>
            
            <button class="btn-nav" style="margin-top: 10px;" onclick="window.location.href='index.html'">🏠 Retour à l'Académie</button>
        </div>

        <!-- ECRAN DE JEU -->
        <div id="ecran-jeu" class="ecran">
            <div id="hud">
                <span id="ui-vies" style="letter-spacing: 5px;">❤️❤️❤️</span>
                <span id="ui-progression" style="color: #7f8c8d;">1 / 5</span>
            </div>
            
            <div id="question-box">
                <div id="question-texte">Chargement...</div>
            </div>

            <div class="zone-boutons" id="boutons-reponses"></div>

            <div id="feedback"></div>
            <button class="btn-nav" onclick="retourAccueil()">⬅️ Changer de thème</button>
        </div>
    </div>

    <script>
        const FIREBASE_URL = "https://academie-famille-default-rtdb.europe-west1.firebasedatabase.app/";
        // On conserve l'ancienne base de données pour garder l'XP de Lola
        const DB_URL = `${FIREBASE_URL}scores/lola/geoLola.json`;

        // BASE DE DONNÉES DÉCOUVERTE DU MONDE CE1
        const bdd = {
            espace: [
                { q: "Sur quel continent habitons-nous ?", rep: "En Europe", faux: ["En Asie", "En Afrique", "En Amérique"] },
                { q: "Quel est le paysage où l'on trouve du sable et la mer ?", rep: "Le littoral (la plage)", faux: ["La montagne", "La campagne", "La forêt"] },
                { q: "Quelle est la capitale de la France ?", rep: "Paris", faux: ["Lyon", "Marseille", "Londres"] },
                { q: "Comment s'appelle une grande étendue d'eau salée ?", rep: "Un océan ou une mer", faux: ["Une rivière", "Un lac", "Un fleuve"] },
                { q: "Qu'est-ce qu'une île ?", rep: "Une terre entourée d'eau", faux: ["Une grande montagne", "Une forêt très dense", "Un désert de sable"] }
            ],
            temps: [
                { q: "Combien y a-t-il de mois dans une année entière ?", rep: "12 mois", faux: ["10 mois", "7 mois", "24 mois"] },
                { q: "Quelle saison vient juste après l'hiver ?", rep: "Le printemps", faux: ["L'été", "L'automne", "La mousson"] },
                { q: "Combien y a-t-il d'heures dans une journée complète ?", rep: "24 heures", faux: ["12 heures", "60 heures", "7 heures"] },
                { q: "Quel mois vient juste après le mois d'Août ?", rep: "Septembre", faux: ["Juillet", "Octobre", "Décembre"] },
                { q: "Dans quelle saison les feuilles tombent-elles des arbres ?", rep: "L'automne", faux: ["Le printemps", "L'été", "L'hiver"] }
            ],
            vivant: [
                { q: "Que faut-il à une plante pour grandir ?", rep: "De l'eau et de la lumière", faux: ["Seulement de la terre", "Du vent et du sable", "Rien du tout"] },
                { q: "Lequel de ces animaux est un mammifère (il allaite ses petits) ?", rep: "Le chat", faux: ["La poule", "Le crocodile", "Le requin"] },
                { q: "Sous quelle forme est l'eau quand elle est transformée en glace ?", rep: "Solide", faux: ["Liquide", "Gazeuse", "Chaude"] },
                { q: "Comment appelle-t-on les animaux qui mangent de la viande ?", rep: "Les carnivores", faux: ["Les herbivores", "Les végétariens", "Les omnivores"] },
                { q: "Quel insecte fabrique du miel ?", rep: "L'abeille", faux: ["La fourmi", "Le moustique", "Le papillon"] }
            ]
        };

        let profil = { xp: 0 };
        let vies = 3; 
        let indexQuestion = 0; 
        let listeQuestions = []; 
        let bloque = false;
        let questionActuelle = null;

        const E = (id) => document.getElementById(id);

        // --- GESTION DU CLOUD ---
        async function chargerProfilCloud() {
            try {
                let res = await fetch(DB_URL);
                let data = await res.json();
                if (data && data.xp !== undefined) profil.xp = parseInt(data.xp) || 0;
            } catch(e) {}
            majXP();
        }

        async function sauverProfilCloud() {
            try { await fetch(DB_URL, { method: 'PUT', body: JSON.stringify({ xp: profil.xp }) }); } catch(e) {}
        }

        function majXP() { E('ui-xp').textContent = `XP: ${profil.xp} ⭐`; }
        function ajouterXP(points) { profil.xp += points; majXP(); sauverProfilCloud(); }

        // --- NAVIGATION ---
        function changerEcran(id) { document.querySelectorAll('.ecran').forEach(e => e.classList.remove('actif')); E(id).classList.add('actif'); }
        function retourAccueil() { changerEcran('ecran-accueil'); }

        // --- MOTEUR DE JEU ---
        function lancerNiveau(mode) {
            vies = 3; 
            indexQuestion = 0; 
            // Mélange et sélectionne 5 questions du thème
            listeQuestions = [...bdd[mode]].sort(() => Math.random() - 0.5).slice(0, 5); 
            
            E('ui-vies').textContent = "❤️❤️❤️"; 
            E('feedback').textContent = ""; 
            
            changerEcran('ecran-jeu'); 
            poserQuestion();
        }

        function poserQuestion() {
            if (vies <= 0) {
                alert("Plus de vies ! Entraîne-toi encore.");
                return retourAccueil();
            }
            if (indexQuestion >= listeQuestions.length) {
                alert("Série terminée ! Bien joué Lola !");
                return retourAccueil();
            }

            bloque = false;
            E('ui-progression').textContent = `${indexQuestion + 1} / ${listeQuestions.length}`; 
            E('feedback').textContent = "";
            
            questionActuelle = listeQuestions[indexQuestion];
            E('question-texte').textContent = questionActuelle.q;
            
            // Mélange de la bonne réponse avec les mauvaises
            let options = [questionActuelle.rep, ...questionActuelle.faux];
            options.sort(() => Math.random() - 0.5);

            const boxBoutons = E('boutons-reponses'); 
            boxBoutons.innerHTML = '';
            
            options.forEach(opt => {
                let btn = document.createElement('button');
                btn.className = "btn-rep";
                btn.textContent = opt;
                btn.onclick = () => validerReponse(btn, opt === questionActuelle.rep);
                boxBoutons.appendChild(btn);
            });
        }

        function validerReponse(btn, isCorrect) {
            if (bloque) return;
            bloque = true;
            
            const fb = E('feedback');
            document.querySelectorAll('.btn-rep').forEach(b => b.onclick = null);

            if (isCorrect) {
                btn.classList.add('correct');
                fb.textContent = "Excellent ! ✨"; fb.style.color = "#27ae60"; ajouterXP(10);
                setTimeout(() => { indexQuestion++; poserQuestion(); }, 1500);
            } else {
                btn.classList.add('erreur');
                fb.textContent = "Aïe... Regarde la bonne réponse."; fb.style.color = "#c0392b";
                
                // Révéler la bonne réponse
                document.querySelectorAll('.btn-rep').forEach(b => {
                    if (b.textContent === questionActuelle.rep) b.classList.add('correct');
                });

                vies--; E('ui-vies').textContent = "❤️".repeat(vies) + "🖤".repeat(3 - vies);
                setTimeout(() => { poserQuestion(); }, 2500);
            }
        }

        chargerProfilCloud();
    </script>
</body>
</html>
